# Copie este arquivo para .env e preencha os valores
# NÃO envie o .env para o Git (já deve estar no .gitignore)

# Chave secreta Django (gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=sua-chave-secreta-aqui

# False em produção, True apenas para desenvolvimento local
DEBUG=False

# Domínios permitidos (separados por vírgula)
# Railway fornece automaticamente via variável RAILWAY_PUBLIC_DOMAIN
ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.up.railway.app

# Origens confiáveis para CSRF (inclua https:// no domínio)
CSRF_TRUSTED_ORIGINS=https://seu-dominio.up.railway.app

# URL do banco de dados (Railway preenche automaticamente)
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=

# Segurança em produção
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# (Opcional) Porta do servidor — Railway define automaticamente
# PORT=8000
